<%- include("partials/navbar") %>

<main class="page-shell">
  <section style="padding:58px 0 80px;background:#fffaf0;">
    <div class="container-global" style="max-width:850px;">
      <header style="margin-bottom:28px;text-align:center;">
        <span style="color:#1f7a4d;font-size:11px;font-weight:850;letter-spacing:1.7px;">ASISTEN TOKO ARIESTA</span>
        <h1 style="margin:9px 0;color:#173326;font-size:40px;letter-spacing:-1px;">Tanya AI <svg class="icon icon-chat" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 1.6 6.4L20 11l-6.4 1.6L12 19l-1.6-6.4L4 11l6.4-1.6L12 3Z"/></svg></h1>
        <p style="color:#737d76;font-size:14px;">Tanyakan informasi umum tentang produk, stok, pengantaran, pembayaran, dan toko.</p>
      </header>

      <section aria-label="Area percakapan AI" style="padding:24px;background:#fff;border:1px solid #e7e5df;border-radius:22px;box-shadow:0 12px 35px rgba(31,41,55,.07);">
        <div id="chatArea" style="min-height:250px;max-height:470px;overflow-y:auto;padding:4px 2px 18px;">
          <div class="ai-bubble" style="max-width:78%;padding:14px 16px;background:#eaf7ef;border:1px solid #d7ebde;border-radius:15px 15px 15px 5px;color:#33433a;font-size:13px;line-height:1.7;">
            <strong style="display:block;color:#1f7a4d;margin-bottom:4px;"><svg class="icon icon-chat" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v11H9l-4 3V5Z"/><path d="M9 10h.01M12 10h.01M15 10h.01"/></svg> Asisten Ariesta</strong>
            Halo! Silakan tanyakan sesuatu mengenai produk atau layanan Toko Ariesta.
          </div>
        </div>

        <form action="#" method="POST" id="aiForm" style="padding-top:18px;border-top:1px solid #eeeae1;">
          <label for="question" style="display:block;margin-bottom:8px;color:#374151;font-size:12px;font-weight:800;">Masukkan Pertanyaan</label>
          <textarea class="input-ui" id="question" name="question" rows="4" required aria-label="Pertanyaan untuk AI" placeholder="Contoh: Beras apa yang tersedia?" style="width:100%;padding:13px 14px;background:#fcfcfa;border:1px solid #deddd6;border-radius:12px;resize:vertical;color:#1f2937;font-size:13px;"></textarea>
          <button type="submit" class="primary-btn" style="width:100%;margin-top:12px;padding:13px;border:none;border-radius:11px;background:#1f7a4d;color:#fff;font-weight:800;font-size:13px;">Kirim Pertanyaan</button>
        </form>
      </section>

      <p style="margin-top:13px;text-align:center;color:#9aa19c;font-size:11px;">Asisten ini menggunakan logika jawaban dummy dari backend sesuai kebutuhan tugas.</p>
    </div>
  </section>
</main>

<%- include("partials/footer") %>