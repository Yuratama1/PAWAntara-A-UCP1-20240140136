<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> - Toko Ariesta</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body
    style="
        margin:0;
        background:#f5f7f9;
        font-family:Arial, sans-serif;
        color:#212529;
    "
>

    <header
        style="
            background:#198754;
            color:#ffffff;
            padding:18px 30px;
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:20px;
        "
    >

        <div>

            <h1
                style="
                    margin:0;
                    font-size:22px;
                "
            >
                Toko Ariesta
            </h1>

            <p
                style="
                    margin:5px 0 0;
                    font-size:13px;
                    opacity:.9;
                "
            >
                Dashboard Admin
            </p>

        </div>

        <button
            id="logoutButton"
            type="button"
            style="
                border:none;
                background:#ffffff;
                color:#198754;
                padding:9px 16px;
                border-radius:8px;
                font-weight:600;
                cursor:pointer;
            "
        >
            Logout
        </button>

    </header>


    <main
        style="
            max-width:1100px;
            margin:0 auto;
            padding:35px 20px;
        "
    >

        <section
            style="
                background:#ffffff;
                padding:28px;
                border-radius:16px;
                box-shadow:0 5px 20px rgba(0,0,0,.06);
            "
        >

            <h2
                style="
                    margin:0 0 8px;
                    font-size:24px;
                "
            >
                Selamat datang, <%= admin.username %>
            </h2>

            <p
                style="
                    margin:0 0 25px;
                    color:#6c757d;
                "
            >
                Kelola produk Toko Ariesta melalui dashboard ini.
            </p>


            <div
                style="
                    display:grid;
                    grid-template-columns:repeat(3, 1fr);
                    gap:18px;
                "
            >

                <div
                    style="
                        padding:20px;
                        border:1px solid #e9ecef;
                        border-radius:12px;
                    "
                >
                    <strong
                        style="
                            display:block;
                            margin-bottom:7px;
                        "
                    >
                        Admin
                    </strong>

                    <span
                        style="
                            color:#6c757d;
                        "
                    >
                        <%= admin.username %>
                    </span>
                </div>


                <div
                    style="
                        padding:20px;
                        border:1px solid #e9ecef;
                        border-radius:12px;
                    "
                >
                    <strong
                        style="
                            display:block;
                            margin-bottom:7px;
                        "
                    >
                        Role
                    </strong>

                    <span
                        style="
                            color:#6c757d;
                        "
                    >
                        <%= admin.role %>
                    </span>
                </div>


                <div
                    style="
                        padding:20px;
                        border:1px solid #e9ecef;
                        border-radius:12px;
                    "
                >
                    <strong
                        style="
                            display:block;
                            margin-bottom:7px;
                        "
                    >
                        Status
                    </strong>

                    <span
                        style="
                            color:#198754;
                            font-weight:600;
                        "
                    >
                        Aktif
                    </span>
                </div>

            </div>

        </section>

    </main>

    <script>

        document
            .getElementById("logoutButton")
            .addEventListener("click", async () => {

                try {

                    const response = await fetch(
                        "/api/logout",
                        {
                            method: "POST"
                        }
                    );

                    const result =
                        await response.json();

                    if (response.ok) {
                        window.location.href = "/login";
                        return;
                    }

                    alert(
                        result.message ||
                        "Logout gagal."
                    );

                } catch (error) {

                    console.error(
                        "Logout error:",
                        error
                    );

                    alert(
                        "Terjadi kesalahan saat logout."
                    );

                }

            });

    </script>

</body>

</html>