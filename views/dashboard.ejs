<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= title %> - Toko Ariesta
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body
    style="
        margin:0;
        background:#f5f7f9;
        font-family:Arial, sans-serif;
        color:#212529;
    "
>

    <header
        style="
            background:#198754;
            color:#ffffff;
            padding:18px 30px;
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:20px;
        "
    >

        <div>

            <h1
                style="
                    margin:0;
                    font-size:22px;
                "
            >
                Toko Ariesta
            </h1>

            <p
                style="
                    margin:5px 0 0;
                    font-size:13px;
                    opacity:.9;
                "
            >
                Dashboard Admin
            </p>

        </div>

        <button
            id="logoutButton"
            type="button"
            style="
                border:none;
                background:#ffffff;
                color:#198754;
                padding:9px 16px;
                border-radius:8px;
                font-weight:600;
                cursor:pointer;
            "
        >
            Logout
        </button>

    </header>


    <main
        style="
            max-width:1100px;
            margin:0 auto;
            padding:35px 20px;
        "
    >

        <section
            style="
                background:#ffffff;
                padding:28px;
                border-radius:16px;
                box-shadow:0 5px 20px rgba(0,0,0,.06);
                margin-bottom:25px;
            "
        >

            <h2
                style="
                    margin:0 0 8px;
                    font-size:24px;
                "
            >
                Kelola Produk
            </h2>

            <p
                style="
                    margin:0 0 25px;
                    color:#6c757d;
                "
            >
                Tambahkan, ubah harga dan stok, atau hapus produk.
            </p>

            <div
                id="messageBox"
                style="
                    display:none;
                    padding:12px 15px;
                    border-radius:8px;
                    margin-bottom:20px;
                    font-size:14px;
                "
            ></div>


            <form id="productForm">

                <input
                    type="hidden"
                    id="productId"
                >

                <h3
                    id="formTitle"
                    style="
                        margin:0 0 18px;
                        font-size:18px;
                    "
                >
                    Tambah Produk
                </h3>


                <div
                    style="
                        display:grid;
                        grid-template-columns:1fr 1fr;
                        gap:18px;
                    "
                >

                    <div>

                        <label
                            for="productName"
                            style="
                                display:block;
                                margin-bottom:7px;
                                font-weight:600;
                            "
                        >
                            Nama Produk
                        </label>

                        <input
                            type="text"
                            id="productName"
                            placeholder="Contoh: Beras Premium 5 Kg"
                            required
                            style="
                                width:100%;
                                box-sizing:border-box;
                                padding:11px 12px;
                                border:1px solid #ced4da;
                                border-radius:8px;
                            "
                        >

                    </div>


                    <div>

                        <label
                            for="productCategory"
                            style="
                                display:block;
                                margin-bottom:7px;
                                font-weight:600;
                            "
                        >
                            Kategori
                        </label>

                        <input
                            type="text"
                            id="productCategory"
                            placeholder="Contoh: Beras"
                            required
                            style="
                                width:100%;
                                box-sizing:border-box;
                                padding:11px 12px;
                                border:1px solid #ced4da;
                                border-radius:8px;
                            "
                        >

                    </div>


                    <div>

                        <label
                            for="productPrice"
                            style="
                                display:block;
                                margin-bottom:7px;
                                font-weight:600;
                            "
                        >
                            Harga
                        </label>

                        <input
                            type="number"
                            id="productPrice"
                            min="0"
                            placeholder="78000"
                            required
                            style="
                                width:100%;
                                box-sizing:border-box;
                                padding:11px 12px;
                                border:1px solid #ced4da;
                                border-radius:8px;
                            "
                        >

                    </div>


                    <div>

                        <label
                            for="productStock"
                            style="
                                display:block;
                                margin-bottom:7px;
                                font-weight:600;
                            "
                        >
                            Stok
                        </label>

                        <input
                            type="number"
                            id="productStock"
                            min="0"
                            placeholder="25"
                            required
                            style="
                                width:100%;
                                box-sizing:border-box;
                                padding:11px 12px;
                                border:1px solid #ced4da;
                                border-radius:8px;
                            "
                        >

                    </div>

                </div>


                <div
                    style="
                        margin-top:20px;
                        display:flex;
                        gap:10px;
                    "
                >

                    <button
                        type="submit"
                        style="
                            border:none;
                            background:#198754;
                            color:#ffffff;
                            padding:10px 18px;
                            border-radius:8px;
                            cursor:pointer;
                            font-weight:600;
                        "
                    >
                        Simpan Produk
                    </button>

                    <button
                        type="button"
                        id="cancelButton"
                        style="
                            display:none;
                            border:1px solid #6c757d;
                            background:#ffffff;
                            color:#495057;
                            padding:10px 18px;
                            border-radius:8px;
                            cursor:pointer;
                        "
                    >
                        Batal
                    </button>

                </div>

            </form>

        </section>


        <section
            style="
                background:#ffffff;
                padding:28px;
                border-radius:16px;
                box-shadow:0 5px 20px rgba(0,0,0,.06);
            "
        >

            <h2
                style="
                    margin:0 0 20px;
                    font-size:20px;
                "
            >
                Daftar Produk
            </h2>

            <div id="productList"></div>

        </section>

    </main>


    <script src="/js/dashboard.js"></script>


    <script>

        document
            .getElementById("logoutButton")
            .addEventListener(
                "click",
                async () => {

                    try {

                        const response =
                            await fetch(
                                "/api/logout",
                                {
                                    method: "POST"
                                }
                            );

                        const result =
                            await response.json();

                        if (response.ok) {

                            window.location.href =
                                "/login";

                            return;
                        }

                        alert(
                            result.message ||
                            "Logout gagal."
                        );

                    } catch (error) {

                        console.error(
                            "Logout error:",
                            error
                        );

                        alert(
                            "Terjadi kesalahan saat logout."
                        );
                    }

                }
            );

    </script>

</body>

</html>