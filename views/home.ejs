<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Beranda</title>
</head>

<body>

<%- include("partials/navbar") %>

<main>

<section class="hero">

<div class="container py-5 text-center">

<h1 class="display-4 fw-bold">

Selamat Datang di Toko Sembako Ariesta

</h1>

<p class="lead">

Belanja kebutuhan pokok menjadi lebih mudah.

</p>

<a href="/produk" class="btn btn-success btn-lg">

Lihat Produk

</a>

</div>

</section>

<section class="container mt-5">

<h2 class="mb-4">

Produk Terbaru

</h2>

<div class="row">

<% products.forEach(product=>{ %>

<div class="col-md-4 mb-4">

<div class="card h-100 shadow">

<img src="<%= product.image %>" class="card-img-top">

<div class="card-body">

<h5><%= product.name %></h5>

<p>

Rp <%= product.price.toLocaleString("id-ID") %>

</p>

<a href="/produk/<%= product.id %>" class="btn btn-success">

Detail

</a>

</div>

</div>

</div>

<% }) %>

</div>

</section>

</main>

<%- include("partials/footer") %>

</body>
</html>