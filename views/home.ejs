<%- include("partials/navbar") %>

<main class="page-shell">
  <section style="padding:68px 0 54px;background:linear-gradient(135deg,#fffaf0 0%,#f3fbf5 100%);overflow:hidden;">
    <div class="container-global">
      <div class="hero-grid" style="display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center;">
        <div>
          <span style="display:inline-flex;align-items:center;gap:7px;padding:7px 12px;background:#eaf7ef;color:#1f7a4d;border-radius:999px;font-size:11px;font-weight:850;letter-spacing:1px;text-transform:uppercase;"><svg class="icon icon-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5C11 4.4 5.4 8.1 5.4 14.2c0 2.8 2 4.8 4.8 4.8 6.1 0 9.8-5.6 9.3-14.5Z"/><path d="M4 20c3.3-4.2 6.6-6.9 11.5-9.5"/></svg> SEMBAKO HARIAN</span>
          <h1 class="hero-title" style="margin-top:16px;color:#173326;font-size:52px;line-height:1.08;letter-spacing:-1.8px;font-weight:850;">
            Belanja kebutuhan<br><span style="color:#1f7a4d;">rumah lebih mudah.</span>
          </h1>
          <p class="hero-description" style="max-width:570px;margin-top:18px;color:#66736b;font-size:15px;line-height:1.8;">
            Toko Sembako Ariesta menyediakan beras, minyak, gula, telur, minuman, dan kebutuhan rumah tangga dengan informasi harga dan stok yang mudah dicek.
          </p>
          <div class="hero-buttons" style="display:flex;gap:11px;margin-top:25px;">
            <a href="/produk" class="primary-btn" style="display:inline-block;padding:13px 21px;background:#1f7a4d;color:#fff;border-radius:12px;font-size:13px;font-weight:800;box-shadow:0 9px 20px rgba(31,122,77,.2);">Lihat Produk →</a>
            <a href="/tanya-ai" class="secondary-btn" style="display:inline-block;padding:12px 20px;background:#fff;color:#1f7a4d;border:1px solid #d8e2da;border-radius:12px;font-size:13px;font-weight:800;"><svg class="icon icon-spark" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 1.6 6.4L20 11l-6.4 1.6L12 19l-1.6-6.4L4 11l6.4-1.6L12 3Z"/></svg> Tanya Asisten</a>
          </div>
          <div style="display:flex;gap:20px;flex-wrap:wrap;margin-top:27px;color:#66736b;font-size:11px;font-weight:700;">
            <span><svg class="icon icon-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg> Harga transparan</span><span><svg class="icon icon-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg> Stok mudah dicek</span><span><svg class="icon icon-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg> Ramah UMKM</span>
          </div>
        </div>

        <div class="hero-visual" style="min-height:390px;border-radius:28px;background:#dff1e5;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid #cde5d4;">
          <div style="width:78%;height:78%;border-radius:26px;background:#fffaf0;display:flex;align-items:center;justify-content:center;font-size:125px;box-shadow:0 22px 45px rgba(31,70,48,.12);"><svg class="icon icon-bag" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/><path d="M8 12h8"/></svg></div>
          <div class="badge-float" style="right:18px;top:22px;padding:11px 14px;background:#fff;color:#173326;border-radius:14px;box-shadow:0 12px 25px rgba(31,41,55,.10);font-size:11px;font-weight:800;"><svg class="icon icon-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5C11 4.4 5.4 8.1 5.4 14.2c0 2.8 2 4.8 4.8 4.8 6.1 0 9.8-5.6 9.3-14.5Z"/><path d="M4 20c3.3-4.2 6.6-6.9 11.5-9.5"/></svg> Belanja praktis</div>
          <div class="badge-float" style="left:18px;bottom:22px;padding:11px 14px;background:#f59e0b;color:#fff;border-radius:14px;box-shadow:0 12px 25px rgba(245,158,11,.20);font-size:11px;font-weight:800;">Harga bersahabat</div>
        </div>
      </div>
    </div>
  </section>

  <section style="padding:28px 0;background:#fff;">
    <div class="container-global">
      <div class="feature-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">
        <article style="padding:20px;background:#f7fbf8;border:1px solid #e4eee7;border-radius:16px;">
          <div style="font-size:25px;"><svg class="icon icon-grain" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V4"/><path d="M12 8c-4-3-6-1-6 1.5S8 13 12 13"/><path d="M12 13c4-3 6-1 6 1.5S16 18 12 18"/><path d="M12 5c-2.5-2-4-1-4 .8S9.5 9 12 9"/></svg></div><h3 style="margin-top:8px;font-size:15px;color:#173326;">Kebutuhan Pokok</h3><p style="margin-top:4px;color:#7a847e;font-size:12px;">Produk harian yang dekat dengan kebutuhan keluarga.</p>
        </article>
        <article style="padding:20px;background:#fffaf0;border:1px solid #f0e7d5;border-radius:16px;">
          <div style="font-size:25px;"><svg class="icon icon-money" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9h.01M18 15h.01"/></svg></div><h3 style="margin-top:8px;font-size:15px;color:#173326;">Harga Terjangkau</h3><p style="margin-top:4px;color:#7a847e;font-size:12px;">Harga ditampilkan jelas agar pelanggan lebih nyaman.</p>
        </article>
        <article style="padding:20px;background:#f7fbf8;border:1px solid #e4eee7;border-radius:16px;">
          <div style="font-size:25px;"><svg class="icon icon-chat" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v11H9l-4 3V5Z"/><path d="M9 10h.01M12 10h.01M15 10h.01"/></svg></div><h3 style="margin-top:8px;font-size:15px;color:#173326;">Tanya Asisten</h3><p style="margin-top:4px;color:#7a847e;font-size:12px;">Tanyakan stok, pengantaran, pembayaran, dan informasi toko.</p>
        </article>
      </div>
    </div>
  </section>

  <section style="padding:58px 0 70px;background:#fffaf0;">
    <div class="container-global">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-bottom:25px;">
        <div>
          <span style="color:#1f7a4d;font-size:11px;font-weight:850;letter-spacing:1.5px;">PRODUK PILIHAN</span>
          <h2 style="margin-top:7px;color:#173326;font-size:30px;line-height:1.2;">Kebutuhan favorit</h2>
          <p style="margin-top:5px;color:#7a847e;font-size:13px;">Beberapa produk sembako yang siap kamu cek.</p>
        </div>
        <a href="/produk" class="secondary-btn" style="padding:10px 15px;background:#fff;color:#1f7a4d;border:1px solid #d8e2da;border-radius:10px;font-size:12px;font-weight:800;">Lihat Semua →</a>
      </div>

      <div class="product-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
        <% products.forEach(product => { %>
          <article class="product-card" style="background:#fff;border:1px solid #e7e5df;border-radius:18px;overflow:hidden;">
            <div style="height:190px;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#f5faf6,#fffaf0);overflow:hidden;">
              <div style="width:92px;height:92px;display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid #e0ebe3;border-radius:24px;font-size:43px;box-shadow:0 14px 28px rgba(31,70,48,.08);"><svg class="icon icon-basket" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h16l-1.2 10H5.2L4 9Z"/><path d="M8 9a4 4 0 0 1 8 0"/><path d="M8 13h.01M12 13h.01M16 13h.01"/></svg></div>
            </div>
            <div style="padding:20px;">
              <span style="color:#1f7a4d;font-size:10px;font-weight:850;letter-spacing:.9px;text-transform:uppercase;"><%= product.category %></span>
              <h3 style="margin-top:7px;color:#26352d;font-size:17px;line-height:1.35;min-height:46px;"><%= product.name %></h3>
              <div style="margin-top:13px;color:#1f7a4d;font-size:22px;font-weight:850;">Rp <%= product.price.toLocaleString("id-ID") %></div>
              <p style="margin-top:4px;color:#8a938d;font-size:11px;">Stok tersedia: <strong style="color:#5c6961;"><%= product.stock %></strong></p>
              <a href="/produk/<%= product.id %>" class="primary-btn" style="display:block;margin-top:16px;padding:11px;background:#1f7a4d;color:#fff;border-radius:10px;text-align:center;font-size:12px;font-weight:800;">Lihat Detail Produk →</a>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") %>