    </button>

    <ul id="navMenu" class="nav-desktop mobile-menu" style="list-style:none;align-items:center;gap:4px;margin:0;padding:0;">
      <li><a href="/" style="display:block;padding:9px 14px;border-radius:10px;color:<%= currentPage === 'home' ? '#145c39' : '#6b7280' %>;background:<%= currentPage === 'home' ? '#eaf7ef' : 'transparent' %>;font-size:13px;font-weight:700;">Beranda</a></li>
      <li><a href="/produk" style="display:block;padding:9px 14px;border-radius:10px;color:<%= currentPage === 'produk' ? '#145c39' : '#6b7280' %>;background:<%= currentPage === 'produk' ? '#eaf7ef' : 'transparent' %>;font-size:13px;font-weight:700;">Produk</a></li>
      <li><a href="/tanya-ai" style="display:block;padding:9px 14px;border-radius:10px;color:<%= currentPage === 'ai' ? '#145c39' : '#6b7280' %>;background:<%= currentPage === 'ai' ? '#eaf7ef' : 'transparent' %>;font-size:13px;font-weight:700;"><svg class="icon icon-chat" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v11H9l-4 3V5Z"/><path d="M9 10h.01M12 10h.01M15 10h.01"/></svg> Tanya AI</a></li>
      <li style="margin-left:8px;"><a href="/produk" class="primary-btn" style="display:block;padding:11px 18px;background:#1f7a4d;color:#fff;border-radius:11px;font-size:12px;font-weight:800;box-shadow:0 6px 14px rgba(31,122,77,.18);">Belanja Sekarang</a></li>
