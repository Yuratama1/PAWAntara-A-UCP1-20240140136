<%- include("partials/navbar") %>

<main class="page-shell">

  <!-- =========================
       HERO
  ========================== -->
  <section style="padding:58px 0 28px;background:#fffaf0;">
    <div class="container-global" style="text-align:center;">

      <span
        style="
          display:inline-block;
          color:#1f7a4d;
          font-size:11px;
          font-weight:850;
          letter-spacing:1.5px;
          text-transform:uppercase;
        "
      >
        KATALOG SEMBAKO
      </span>

      <h1
        class="page-title"
        style="
          margin-top:8px;
          color:#173326;
          font-size:43px;
          line-height:1.15;
          letter-spacing:-1px;
        "
      >
        Kebutuhan harian,
        <span style="color:#1f7a4d;">
          lebih mudah dicari.
        </span>
      </h1>

      <p
        style="
          max-width:620px;
          margin:12px auto 0;
          color:#718078;
          font-size:14px;
        "
      >
        Cari produk berdasarkan nama atau kategori
        untuk menemukan kebutuhan rumah tangga dengan cepat.
      </p>

    </div>
  </section>


  <!-- =========================
       FILTER
  ========================== -->
  <section style="padding:14px 0 30px;background:#fffaf0;">

    <div class="container-global">

      <div
        style="
          padding:20px;
          background:#fff;
          border:1px solid #e7e5df;
          border-radius:18px;
          box-shadow:0 8px 25px rgba(31,41,55,.05);
        "
      >

        <form id="filterForm">

          <div
            class="filter-grid"
            style="
              display:grid;
              grid-template-columns:1.4fr 1fr auto;
              gap:10px;
            "
          >

            <!-- SEARCH -->
            <div>

              <label
                for="search"
                style="
                  display:block;
                  margin-bottom:7px;
                  color:#374151;
                  font-size:11px;
                  font-weight:800;
                "
              >
                Cari Produk
              </label>

              <input
                class="input-ui"
                id="search"
                type="text"
                name="search"
                placeholder="Contoh: Beras, Minyak, Gula..."
                autocomplete="off"
                style="
                  width:100%;
                  height:48px;
                  padding:0 14px;
                  background:#fcfcfa;
                  border:1px solid #deddd6;
                  border-radius:11px;
                  color:#1f2937;
                  font-size:13px;
                  box-sizing:border-box;
                "
              >

            </div>


            <!-- CATEGORY -->
            <div>

              <label
                for="kategori"
                style="
                  display:block;
                  margin-bottom:7px;
                  color:#374151;
                  font-size:11px;
                  font-weight:800;
                "
              >
                Kategori
              </label>

              <select
                class="input-ui"
                id="kategori"
                name="kategori"
                style="
                  width:100%;
                  height:48px;
                  padding:0 14px;
                  background:#fcfcfa;
                  border:1px solid #deddd6;
                  border-radius:11px;
                  color:#1f2937;
                  font-size:13px;
                  box-sizing:border-box;
                "
              >

                <option value="">
                  Semua Kategori
                </option>

              </select>

            </div>


            <!-- BUTTON -->
            <div style="display:flex;align-items:flex-end;">

              <button
                type="submit"
                class="primary-btn"
                style="
                  width:100%;
                  height:48px;
                  padding:0 20px;
                  background:#1f7a4d;
                  color:#fff;
                  border:none;
                  border-radius:11px;
                  font-size:13px;
                  font-weight:800;
                  cursor:pointer;
                "
              >
                Cari Produk
              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </section>


  <!-- =========================
       PRODUCT SECTION
  ========================== -->
  <section style="padding:22px 0 70px;background:#fffaf0;">

    <div class="container-global">

      <!-- HEADER -->
      <div
        style="
          display:flex;
          justify-content:space-between;
          align-items:center;
          gap:15px;
          margin-bottom:24px;
        "
      >

        <div>

          <h2
            style="
              margin:0;
              color:#173326;
              font-size:22px;
            "
          >
            Produk Sembako
          </h2>

          <p
            style="
              margin-top:3px;
              color:#929a95;
              font-size:12px;
            "
          >
            Temukan kebutuhan yang kamu cari.
          </p>

        </div>


        <!-- JUMLAH PRODUK -->
        <div
          id="productCount"
          style="
            padding:7px 11px;
            background:#eaf7ef;
            color:#1f7a4d;
            border-radius:999px;
            font-size:11px;
            font-weight:850;
          "
        >
          Memuat...
        </div>

      </div>


      <!-- =========================
           MESSAGE
      ========================== -->

      <div
        id="productMessage"
        role="status"
        aria-live="polite"
        style="
          display:none;
          padding:14px 16px;
          margin-bottom:20px;
          border-radius:10px;
          font-size:13px;
        "
      ></div>


      <!-- =========================
           PRODUCT CONTAINER
      ========================== -->

      <div
        id="productContainer"
        class="product-grid"
        aria-live="polite"
        style="
          display:grid;
          grid-template-columns:repeat(3,1fr);
          gap:20px;
        "
      ></div>

    </div>

  </section>

</main>


<%- include("partials/footer") %>


<script src="/js/products.js"></script>